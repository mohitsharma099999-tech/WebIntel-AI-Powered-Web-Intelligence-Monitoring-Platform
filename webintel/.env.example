# =====================================================================
# Application
# =====================================================================
APP_NAME="Browser Scraper API"
APP_ENV=development                    # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=change-me-to-a-long-random-string
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================================================================
# Database (PostgreSQL + async driver)
# =====================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scraper_db
# For Alembic (sync driver) — usually the same URL with psycopg2 or the async URL is fine
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scraper_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# =====================================================================
# Browser pool
# =====================================================================
BROWSER_POOL_MAX_SIZE=5
BROWSER_POOL_MIN_SIZE=1
BROWSER_ACQUIRE_TIMEOUT=30
BROWSER_MAX_USES_PER_INSTANCE=100
BROWSER_MAX_AGE_SECONDS=1800
BROWSER_MAX_IDLE_SECONDS=300
BROWSER_HEALTH_CHECK_INTERVAL=30
BROWSER_RECYCLE_INTERVAL=60

# Playwright / browser settings
BROWSER_TYPE=chromium                  # chromium | firefox | webkit
BROWSER_HEADLESS=true
BROWSER_LAUNCH_ARGS=--no-sandbox,--disable-dev-shm-usage,--disable-gpu
BROWSER_DEFAULT_TIMEOUT_MS=30000
BROWSER_NAVIGATION_TIMEOUT_MS=45000

# Optional proxy for outbound scraping
BROWSER_PROXY_URL=
# e.g. http://user:pass@proxy.example.com:8080

# =====================================================================
# Scraper
# =====================================================================
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; ScraperBot/1.0; +https://example.com/bot)"
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BACKOFF_SECONDS=2
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_RESPECT_ROBOTS_TXT=true
SCRAPER_CONCURRENCY=10
SCRAPER_BLOCK_RESOURCES=image,font,media,stylesheet

# =====================================================================
# Change detector
# =====================================================================
CHANGE_DETECTOR_STORAGE_DIR=./storage/snapshots
CHANGE_DETECTOR_HASH_ALGORITHM=sha256
CHANGE_DETECTOR_IGNORE_SELECTORS=.timestamp,.ad,.cookie-banner
CHANGE_DETECTOR_NORMALIZE_WHITESPACE=true
CHANGE_DETECTOR_STORE_RAW_HTML=false

# =====================================================================
# Scheduler (background change checks)
# =====================================================================
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MAX_CONCURRENT_JOBS=5

# =====================================================================
# Auth (optional)
# =====================================================================
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =====================================================================
# Rate limiting
# =====================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =====================================================================
# Observability
# =====================================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false
